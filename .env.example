# Grok / xAI Vision + chat analysis
# Set AI_ANALYSIS_MOCK=true for local/demo mode without calling Grok.
XAI_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
GROK_VISION_MODEL=grok-4
# Optional comma-separated fallback list. Used only if the primary model is unavailable.
GROK_VISION_MODEL_CANDIDATES=
GROK_MAX_OUTPUT_TOKENS=700
AI_ANALYSIS_MOCK=false
AI_ANALYSIS_MAX_IMAGE_MB=1
AI_ANALYSIS_MAX_OUTPUT_TOKENS=500
# When Grok/xAI is overloaded, return a safe fallback result instead of failing the Mini App.
AI_ANALYSIS_FALLBACK_ON_GROK_CAPACITY=true

# Public site URL for callbacks and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SaaS UI mode. false = product landing/order mode by default; true = show SaaS nav and subscription-first flows.
SAAS_MODE=false
MINI_APP=false

# Hutko / PUMB acquiring
HUTKO_MERCHANT_ID=
HUTKO_SECRET_KEY=
HUTKO_API_DOMAIN=pay.hutko.org
HUTKO_SUCCESS_URL=http://localhost:3000/?payment=success
HUTKO_CALLBACK_URL=http://localhost:3000/api/payments/hutko/callback

# Telegram Auth for SaaS session
# Website login uses Telegram OIDC + PKCE. Mini App login uses signed initData.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:3000/api/auth/telegram/callback
AUTH_SESSION_SECRET=change-me-long-random-string
AUTH_SESSION_MAX_AGE_SECONDS=2592000
# Telegram login is optional by default. Set true only for closed SaaS mode.
AUTH_REQUIRE_TELEGRAM=false

# Telegram bot notifications about orders, payments and TTN
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_ORDER_NOTIFICATIONS=true
TELEGRAM_INCLUDE_LABEL_URL=false

# Order storage. File storage is convenient for VPS/dev. Use a DB on serverless production.
ORDER_STORE_DIR=.data/orders
ORDER_ADMIN_TOKEN=change-me-admin-token

# Auto-create TTN after approved payment callback. Set false to create manually through /api/delivery/ttn/create.
DELIVERY_AUTO_CREATE_TTN=true

# Nova Poshta API 2.0 TTN creation
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_CITY_SENDER_REF=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=
NOVA_POSHTA_CONTACT_SENDER_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_PAYER_TYPE=Sender
NOVA_POSHTA_PAYMENT_METHOD=Cash
NOVA_POSHTA_CARGO_TYPE=Parcel
NOVA_POSHTA_SERVICE_TYPE=WarehouseWarehouse
NOVA_POSHTA_SEATS_AMOUNT=1
NOVA_POSHTA_DEFAULT_WEIGHT_KG=0.5
NOVA_POSHTA_DEFAULT_VOLUME=0.002
NOVA_POSHTA_DESCRIPTION=Sibionics GS3 CGM

# Ukrposhta eCommerce API TTN creation
UKRPOSHTA_BEARER=
UKRPOSHTA_COUNTERPARTY_TOKEN=
UKRPOSHTA_COUNTERPARTY_UUID=
UKRPOSHTA_SENDER_UUID=
UKRPOSHTA_SENDER_ADDRESS_ID=
UKRPOSHTA_API_BASE=https://www.ukrposhta.ua/ecom/0.0.1
UKRPOSHTA_FORMS_BASE=https://www.ukrposhta.ua/forms/ecom/0.0.1
UKRPOSHTA_SHIPMENT_TYPE=EXPRESS
UKRPOSHTA_DELIVERY_TYPE=W2W
UKRPOSHTA_PAID_BY_RECIPIENT=false
UKRPOSHTA_SMS=true
UKRPOSHTA_DEFAULT_WEIGHT_GRAMS=500
UKRPOSHTA_DEFAULT_LENGTH_CM=20
UKRPOSHTA_INCLUDE_LABEL_URL=false

# AI Diabetes SaaS extension
NEXT_PUBLIC_DEFAULT_LOCALE=ua
CGM_AI_PREDICTION=false
# Server-side TTS is disabled in Grok mode; clients use browser speechSynthesis fallback.

# Telegram Mini App login. TELEGRAM_BOT_TOKEN can be reused.
TELEGRAM_MINI_APP_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Subscription billing through WayForPay checkout + callback activation
SUBSCRIPTION_DEFAULT_PLAN=pro
SUBSCRIPTION_RENEWAL_GRACE_DAYS=3

# WayForPay acquiring (default payment provider)
# Public sandbox/test credentials from WayForPay documentation can be enabled for local smoke tests.
WAYFORPAY_USE_TEST_CREDENTIALS=true
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_MERCHANT_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_MERCHANT_DOMAIN_NAME=www.market.ua
WAYFORPAY_PURCHASE_URL=https://secure.wayforpay.com/pay
WAYFORPAY_RETURN_URL=http://localhost:3000/?payment=success
WAYFORPAY_SERVICE_URL=http://localhost:3000/api/payments/wayforpay/callback
WAYFORPAY_LANGUAGE=UA
WAYFORPAY_DEFAULT_PAYMENT_SYSTEM=card
WAYFORPAY_PAYMENT_SYSTEMS=card;googlePay;applePay
WAYFORPAY_ORDER_TIMEOUT_SECONDS=49000

# WayForPay full smoke test options
# Keep real credentials only in .env.local. Do not commit them.
WAYFORPAY_API_URL=https://api.wayforpay.com/api
WAYFORPAY_TEST_TIMEOUT_MS=30000
WAYFORPAY_TEST_SAVE_REPORT=true
WAYFORPAY_TEST_RUN_CHECK_STATUS=true
WAYFORPAY_TEST_RUN_LOCAL_CALLBACK=false
WAYFORPAY_TEST_ORDER_REFERENCE=
WAYFORPAY_TEST_AMOUNT=1400
WAYFORPAY_TEST_CURRENCY=UAH
WAYFORPAY_TEST_PRODUCT_1_NAME=Sibionics GS3 test sensor
WAYFORPAY_TEST_PRODUCT_1_COUNT=1
WAYFORPAY_TEST_PRODUCT_1_PRICE=900
WAYFORPAY_TEST_PRODUCT_2_NAME=Sibionics GS3 test transponder
WAYFORPAY_TEST_PRODUCT_2_COUNT=1
WAYFORPAY_TEST_PRODUCT_2_PRICE=500
WAYFORPAY_TEST_CLIENT_FIRST_NAME=Тест
WAYFORPAY_TEST_CLIENT_LAST_NAME=Клієнт
WAYFORPAY_TEST_CLIENT_EMAIL=test@example.com
WAYFORPAY_TEST_CLIENT_PHONE=380993177636

# Telegram auth tests
# Smoke test is local/mock by default. Set TELEGRAM_SMOKE_BASE_URL to also POST mock initData to a running app.
TELEGRAM_SMOKE_BOT_TOKEN=1234567890:mock-telegram-bot-token-for-local-smoke-test
TELEGRAM_SMOKE_BASE_URL=
TELEGRAM_TEST_REPORT_DIR=scripts/reports
TELEGRAM_TEST_SAVE_REPORT=true

# Nightly E2E uses a real Telegram test account through Mini App initData.
# Keep TELEGRAM_NIGHTLY_INIT_DATA as a CI secret. It is signed by Telegram and expires according to TELEGRAM_INITDATA_MAX_AGE_SECONDS.
TELEGRAM_NIGHTLY_REAL_TEST_ENABLED=false
TELEGRAM_NIGHTLY_BASE_URL=https://your-domain.com
TELEGRAM_NIGHTLY_INIT_DATA=
TELEGRAM_NIGHTLY_EXPECTED_TELEGRAM_ID=
TELEGRAM_NIGHTLY_INITDATA_MAX_AGE_SECONDS=86400
TELEGRAM_NIGHTLY_CHECK_BOT_API=true
