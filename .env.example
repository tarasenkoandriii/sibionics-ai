# OpenAI Vision / AI photo analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public site URL for callbacks and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hutko / PUMB acquiring
HUTKO_MERCHANT_ID=
HUTKO_SECRET_KEY=
HUTKO_API_DOMAIN=pay.hutko.org
HUTKO_SUCCESS_URL=http://localhost:3000/?payment=success
HUTKO_CALLBACK_URL=http://localhost:3000/api/payments/hutko/callback

# Optional Telegram Login via OIDC
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:3000/api/auth/telegram/callback
AUTH_SESSION_SECRET=change-me-long-random-string

# Telegram bot notifications about orders, payments and TTN
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_ORDER_NOTIFICATIONS=true
TELEGRAM_INCLUDE_LABEL_URL=false

# Order storage. File storage is convenient for VPS/dev. Use a DB on serverless production.
ORDER_STORE_DIR=.data/orders
ORDER_ADMIN_TOKEN=change-me-admin-token

# Auto-create TTN after approved Hutko callback. Set false to create manually through /api/delivery/ttn/create.
DELIVERY_AUTO_CREATE_TTN=true

# Nova Poshta API 2.0 TTN creation
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_CITY_SENDER_REF=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=
NOVA_POSHTA_CONTACT_SENDER_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_PAYER_TYPE=Sender
NOVA_POSHTA_PAYMENT_METHOD=Cash
NOVA_POSHTA_CARGO_TYPE=Parcel
NOVA_POSHTA_SERVICE_TYPE=WarehouseWarehouse
NOVA_POSHTA_SEATS_AMOUNT=1
NOVA_POSHTA_DEFAULT_WEIGHT_KG=0.5
NOVA_POSHTA_DEFAULT_VOLUME=0.002
NOVA_POSHTA_DESCRIPTION=Sibionics GS3 CGM

# Ukrposhta eCommerce API TTN creation
UKRPOSHTA_BEARER=
UKRPOSHTA_COUNTERPARTY_TOKEN=
UKRPOSHTA_COUNTERPARTY_UUID=
UKRPOSHTA_SENDER_UUID=
UKRPOSHTA_SENDER_ADDRESS_ID=
UKRPOSHTA_API_BASE=https://www.ukrposhta.ua/ecom/0.0.1
UKRPOSHTA_FORMS_BASE=https://www.ukrposhta.ua/forms/ecom/0.0.1
UKRPOSHTA_SHIPMENT_TYPE=EXPRESS
UKRPOSHTA_DELIVERY_TYPE=W2W
UKRPOSHTA_PAID_BY_RECIPIENT=false
UKRPOSHTA_SMS=true
UKRPOSHTA_DEFAULT_WEIGHT_GRAMS=500
UKRPOSHTA_DEFAULT_LENGTH_CM=20
UKRPOSHTA_INCLUDE_LABEL_URL=false

# AI Diabetes SaaS extension
NEXT_PUBLIC_DEFAULT_LOCALE=ua
CGM_AI_PREDICTION=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Telegram Mini App login. TELEGRAM_BOT_TOKEN can be reused.
TELEGRAM_MINI_APP_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Subscription billing through Hutko checkout + callback activation
SUBSCRIPTION_DEFAULT_PLAN=pro
SUBSCRIPTION_RENEWAL_GRACE_DAYS=3
